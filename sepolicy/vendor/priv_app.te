# MiuiCamera (itzdf mod, 3rd-party signature) runs as priv_app (or priv_app_36 when targeting SDK 36).
# Rules required for MIVI2 offline pipeline (IBGService) + misys + miev.
# Verified on-device 2026-08-24 (see scratch/camera_itzdf/tools/README.md).

# MIVI2 offline processing daemon (hosted in camera provider process)
allow priv_app_all hal_aidlbgservice_service:service_manager find;

# Xiaomi misys HAL (vendor.xiaomi.hardware.misys)
allow priv_app_all hal_misys_vendor_service:service_manager find;
binder_call(priv_app_all, hal_misys_vendor)

# Binder callbacks from camera provider into the app (capture results)
binder_call(hal_camera_default, priv_app_all)
binder_call(priv_app_all, hal_camera_default)

# MIVI event reporting device
allow priv_app_all miev_device:chr_file { open write };

# Vendor props probed by camera setup / algo framework
# NOTE: vendor_default_prop is neverallow-protected by platform policy —
# the camera works fine without it (denials are non-blocking).
allow priv_app_all vendor_displayfeature_prop:file { read open getattr map };
