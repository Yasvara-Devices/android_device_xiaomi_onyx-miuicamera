# MiuiCamera port support: the provider hosts the MIVI2 IBGService daemon and
# calls back into the camera app (priv_app_all or platform_app_all, which cover
# the targetSdk-36 priv_app_36/platform_app_36 domains) with results.
binder_call(hal_camera_default, platform_app_all)
binder_call(hal_camera_default, priv_app_all)

# MIVI reads the panel id (/sys/.../panel_build_id) to pick display-tuned params
allow hal_camera_default vendor_sysfs_displayfeature:file r_file_perms;

# MIVI HEIC encoder (yuv2Heic / libheichal / AMediaMuxer) memfd tmpfs & media_config_prop
tmpfs_domain(hal_camera_default)
get_prop(hal_camera_default, media_config_prop)
